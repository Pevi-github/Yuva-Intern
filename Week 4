import numpy as np
import pandas as pd
import scipy.spatial.distance as dist
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import (
    mean_absolute_error,
    r2_score,
    root_mean_squared_error,
)
from sklearn.model_selection import GridSearchCV, train_test_split

# 1. SIMULATE DEMAND TIME-SERIES DATASET
np.random.seed(42)
dates = pd.date_range(start="2025-01-01", periods=365, freq="D")
demand_df = pd.DataFrame({
    "date": dates,
    "day_of_week": dates.dayofweek,
    "month": dates.month,
    "is_weekend": dates.dayofweek.isin([5, 6]).astype(int),
    "promotional_event": np.random.choice([0, 1], size=365, p=[0.85, 0.15]),
})

# Generate realistic SKU demand with lag feature
demand_df["units_demanded"] = (
    120
    + (demand_df["day_of_week"] * 14)
    + (demand_df["promotional_event"] * 95)
    + np.random.normal(0, 18, 365)
).astype(int)
demand_df["lag_1_demand"] = (
    demand_df["units_demanded"]
    .shift(1)
    .fillna(demand_df["units_demanded"].mean())
)

# 2. MODEL TRAINING & HYPERPARAMETER TUNING
X = demand_df[[
    "day_of_week",
    "month",
    "is_weekend",
    "promotional_event",
    "lag_1_demand",
]]
y = demand_df["units_demanded"]

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.2, shuffle=False
)

param_grid = {
    "n_estimators": [50, 100],
    "max_depth": [5, 10, None],
    "min_samples_split": [2, 5],
}

rf = RandomForestRegressor(random_state=42)
grid_search = GridSearchCV(
    rf, param_grid, cv=3, scoring="neg_root_mean_squared_error"
)
grid_search.fit(X_train, y_train)

best_model = grid_search.best_estimator_
y_pred = best_model.predict(X_test)

# 3. EVALUATION METRICS
mae = mean_absolute_error(y_test, y_pred)
rmse = root_mean_squared_error(y_test, y_pred)
r2 = r2_score(y_test, y_pred)

print("=== PREDICTIVE MODEL PERFORMANCE ===")
print(f"Best Parameters      : {grid_search.best_params_}")
print(f"Mean Absolute Error  : {mae:.2f} units")
print(f"Root Mean Sq. Error  : {rmse:.2f} units")
print(f"R-squared Score      : {r2:.4f}")


# 4. OPTIMIZATION STRATEGY: ROUTE HEURISTIC (TSP)
def nearest_neighbor_tsp(warehouse, delivery_points):
  unvisited = list(delivery_points)
  current_pos = warehouse
  route = [current_pos]
  total_dist = 0.0
  while unvisited:
    distances = [dist.euclidean(current_pos, pt) for pt in unvisited]
    nearest_idx = np.argmin(distances)
    total_dist += distances[nearest_idx]
    current_pos = unvisited.pop(nearest_idx)
    route.append(current_pos)
  total_dist += dist.euclidean(current_pos, warehouse)
  route.append(warehouse)
  return route, total_dist


warehouse_coord = (11.6643, 78.1460)  # Salem Hub
delivery_coords = [
    (11.6800, 78.1500),
    (11.6500, 78.1200),
    (11.7000, 78.1800),
    (11.6300, 78.1100),
]
opt_route, total_distance = nearest_neighbor_tsp(
    warehouse_coord, delivery_coords
)

print("\n=== ROUTE OPTIMIZATION RESULTS ===")
print(f"Optimized Stop Sequence Count : {len(opt_route)} stops")
print(f"Total Distance Index          : {total_distance:.4f} units")
